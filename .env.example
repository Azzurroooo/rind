# Rind TypeScript Runtime & Docker Compose Configuration

# Required bearer token authenticating Web/Remote/Gateway clients to the runtime worker
RIND_SERVER_TOKEN=

# Host paths mounted into Docker Compose containers
RIND_WORKSPACE=.
RIND_HOME=./.rind

# Web Nginx bind address and port (keep 127.0.0.1 unless behind a trusted reverse proxy)
RIND_WEB_BIND=127.0.0.1
RIND_WEB_PORT=8080

# Model provider API keys (can also be configured interactively via /login or auth.json)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Outbound network proxy settings (optional)
HTTPS_PROXY=
NO_PROXY=
